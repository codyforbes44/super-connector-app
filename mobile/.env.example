# Copy to mobile/.env. Do not commit the copy.
# Same Supabase project as the web app (Lovable Cloud).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
EXPO_PUBLIC_API_BASE_URL=https://sixvox.3bi.io

# sandbox for dev-client builds, production for TestFlight and Play.
# Leave unset to follow __DEV__ (sandbox in debug, production in release).
# EXPO_PUBLIC_PUSH_ENVIRONMENT=sandbox

# Local UI only. Does not register with Twilio or place calls.
# EXPO_PUBLIC_UI_PREVIEW=1

# Created by `eas init`. Not a secret, but unique to the Expo account.
# EAS_PROJECT_ID=
